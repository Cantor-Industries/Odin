# Drone vision telemetry configuration.
# Read by telemetry/server.py at startup. Edit, then:
#     sudo systemctl restart drone-telemetry
#
# ---------------------------------------------------------------------------
# TELEM_SOURCE selects where telemetry comes from:
#
#   auto                              probe serial ports, wait if nothing answers  <- default
#   serial:/dev/ttyUSB0:57600         USB-serial adapter (recommended for APM 2.8)
#   serial:/dev/ttyAMA0:57600         Pi GPIO UART (needs a 5V->3.3V level shifter!)
#   udp:127.0.0.1:14550               MAVLink over UDP (simulator / SITL / MAVProxy)
#   sim                               fake data generated in-process, no MAVLink
#   file:/path/to/flight.tlog         replay a captured log
#
# With no flight controller attached, `auto` is correct: the service stays up,
# the page loads, and the HUD shows NO FC until a heartbeat appears.
# ---------------------------------------------------------------------------
TELEM_SOURCE=auto

# Serial device and baud used by `auto`. APM 2.8 defaults to 57600.
TELEM_DEVICE=/dev/ttyUSB0
TELEM_BAUD=57600

# Web server for the HUD page and the /ws feed.
TELEM_HOST=0.0.0.0
TELEM_PORT=8080

# Battery cell count. The APM reports pack voltage only, so this is how the
# HUD derives per-cell voltage. 0 = unknown (per-cell shows ---).
# Common: 3 for 3S, 4 for 4S, 6 for 6S.
TELEM_CELLS=0

# Optional: append the raw MAVLink stream to a .tlog for later replay.
# Use an absolute path outside the repo, e.g. /var/log/odin/flight.tlog
# TELEM_LOG_RAW=

# go2rtc, used when restarting the camera after a colour change.
GO2RTC_URL=http://127.0.0.1:1984
GO2RTC_STREAM=drone
